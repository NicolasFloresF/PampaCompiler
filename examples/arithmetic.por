programa {
  funcao inicio() {
    inteiro a = 20
    inteiro b = 6
    inteiro sum = a + b
    inteiro difference = a - b
    inteiro product = a * b
    inteiro quotient = a / b
    escreva(a, " + ", b, " = ", sum, "\n")
    escreva(a, " - ", b, " = ", difference, "\n")
    escreva(a, " * ", b, " = ", product, "\n")
    escreva(a, " / ", b, " = ", quotient, "\n")
  }
}
